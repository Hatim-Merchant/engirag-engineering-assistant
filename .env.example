# =============================================================================
# EngiRAG Environment Configuration
# Copy this file to .env for local development. 
# =============================================================================

# --- Server ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL / pgvector ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=engirag
POSTGRES_PASSWORD=engirag_dev_password
POSTGRES_DB=engirag
DATABASE_URL=postgresql://engirag:engirag_dev_password@localhost:5432/engirag

# --- Embeddings (Phase 2 & 3) ---
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# --- LLM Provider (Phase 3) ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# Optional fallback / alternative provider (Phase 3)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- RAG Parameters (Phase 2 & 3) ---
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35
