# =============================================================================
# EngiRAG Backend Environment Configuration
# In a monorepo setup, the backend automatically reads either ../.env or .env.
# =============================================================================

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=engirag
POSTGRES_PASSWORD=engirag_dev_password
POSTGRES_DB=engirag
DATABASE_URL=postgresql://engirag:engirag_dev_password@localhost:5432/engirag

EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35
